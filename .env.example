# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Loaded automatically by scripts/run_local_groq.sh and main.py. A variable
# already set in your shell takes precedence; empty values are ignored.

# Groq API key for gpt-oss-120b-groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Hugging Face access token, used to download the NLI model for graph / MIS /
# sampleMIS and other HF models (https://huggingface.co/settings/tokens).
# A read-only token is enough.
HF_TOKEN=

# Wulver, your own gpt-oss-120b server (optional; these are the defaults):
# where scripts/download_gpt_oss.sh puts the weights and serve_gpt_oss_local.slurm reads them
# GPT_OSS_DIR=/project/ss797/dk694/models/gpt-oss-120b
# address file the server writes and the experiment jobs read
# LOCAL_VLLM_SERVER_FILE=/home/dk694/vllm_local_server.txt
